# No external API key is needed to run the current frontend.
# Add server-side integrations here only when an implemented feature requires them.

# Full publicly reachable URL of the Cồn Chim page, including any subdirectory.
# Leave empty during local development; story QR stays unavailable on localhost.
VITE_CON_CHIM_PUBLIC_URL=
# Public URL of the deployed index.html, including any subdirectory.
# Used by QR links for every heritage site; localhost cannot be opened on a phone.
VITE_PUBLIC_URL=

# Demo MP3: defaults to true in dev and false in production builds.
# Set explicitly to true only for a demonstration build; false disables the fallback.
# Official per-content MP3 URLs continue to work when demo is disabled.
# VITE_AUDIO_DEMO_ENABLED=false
